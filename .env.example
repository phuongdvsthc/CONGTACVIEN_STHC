# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_BASE_URL: Domain công khai của hệ thống tuyển sinh (ví dụ: https://sthc-ctv-system.onrender.com hoặc https://tuyensinh.sthc.edu.vn)
# Bắt buộc cấu hình trên Render (Dashboard > Environment) để cấp link giới thiệu công khai và mã QR định danh cho CTV.
APP_BASE_URL="https://sthc-ctv-system.onrender.com"

# ==============================================================================
# SUPABASE CONFIGURATION (DÀNH RIÊNG CHO HỆ THỐNG CTV TUYỂN SINH SAIGONTOURIST)
# ==============================================================================
# URL dự án Supabase thử nghiệm CTV (Ví dụ: https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-ctv-project-id.supabase.co"

# Service Role Secret Key (Chỉ dùng trên server backend / script bootstrap an toàn)
# TUYỆT ĐỐI KHÔNG commit giá trị thật vào Git hoặc chia sẻ client.
SUPABASE_SERVICE_ROLE_KEY="your-ctv-service-role-secret-key"

# Thông tin bootstrap Admin (Tuỳ chọn: cung cấp qua biến môi trường hoặc nhập khi chạy)
BOOTSTRAP_ADMIN_EMAIL="admin-ctv-staging@domain.edu.vn"
BOOTSTRAP_ADMIN_PASSWORD="SecureGeneratedPassword123!"
BOOTSTRAP_ADMIN_NAME="Quản trị viên Tuyển sinh"
